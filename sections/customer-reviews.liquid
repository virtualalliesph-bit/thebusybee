      "default": "#FBE6C8"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Review card color",
      "default": "#FFDEAB"
    },
    {
      "type": "header",
      "content": "Review 1"
    },
    {
      "type": "textarea",
