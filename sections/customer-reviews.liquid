      "default": "\"I've tried the oatmeal scrub - smelled so good and I didn't want to get out of the shower!\""
    },
    {
      "type": "text",
      "id": "handle_1",
      "label": "Customer",
      "default": "@iamsheilasnow"
    },
    {
      "type": "header",
      "content": "Review 2"
    },
    {
      "type": "textarea",
      "id": "review_2",
      "label": "Review",
      "default": "\"Smells amazing! Thanks so much!\""
    },
    {
      "type": "text",
      "id": "handle_2",
      "label": "Customer",
      "default": "@mauwrob"
    },
    {
      "type": "header",
      "content": "Review 3"
    },
    {
      "type": "textarea",
      "id": "review_3",
      "label": "Review",
      "default": "\"Body scrubs my current fave shower buds!\""
