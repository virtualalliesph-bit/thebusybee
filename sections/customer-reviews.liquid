<section class="busy-bee-reviews">
  <div class="busy-bee-reviews__inner">
    {% if section.settings.heading != blank %}
      <h2 class="busy-bee-reviews__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    <div class="busy-bee-reviews__grid">
      {% for index in (1..4) %}
        {% liquid
          assign review_key = 'review_' | append: index
          assign handle_key = 'handle_' | append: index
          assign review_text = section.settings[review_key]
          assign review_handle = section.settings[handle_key]
        %}
        {% if review_text != blank or review_handle != blank %}
          <article class="busy-bee-reviews__card">
            {% if review_text != blank %}
              <p class="busy-bee-reviews__quote"><em>{{ review_text | escape }}</em></p>
            {% endif %}
            {% if review_handle != blank %}
              <p class="busy-bee-reviews__handle"><strong>{{ review_handle | escape }}</strong></p>
            {% endif %}
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} .busy-bee-reviews {
    background: {{ section.settings.background_color }};
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .busy-bee-reviews__inner {
    width: min(1200px, calc(100% - 48px));
    margin-inline: auto;
  }

  #shopify-section-{{ section.id }} .busy-bee-reviews__heading {
    margin: 0 0 28px;
    text-align: center;
    font-family: var(--font-heading--family);
  }

  #shopify-section-{{ section.id }} .busy-bee-reviews__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .busy-bee-reviews__card {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
    margin: 0;
    padding: 24px;
    border-radius: 18px;
    background: {{ section.settings.card_color }};
  }

  #shopify-section-{{ section.id }} .busy-bee-reviews__quote,
  #shopify-section-{{ section.id }} .busy-bee-reviews__handle {
    margin: 0;
    font-family: var(--font-body--family);
  }

  #shopify-section-{{ section.id }} .busy-bee-reviews__quote {
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .busy-bee-reviews__handle {
    font-size: 0.875rem;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .busy-bee-reviews__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .busy-bee-reviews__inner {
      width: min(100% - 32px, 1200px);
    }

    #shopify-section-{{ section.id }} .busy-bee-reviews__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

{% schema %}
