<section class="busybee-scrub-story" style="--bb-page-bg: {{ section.settings.page_background }}; --bb-accent-bg: {{ section.settings.accent_background }}; --bb-card-bg: {{ section.settings.card_background }}; --bb-text: {{ section.settings.text_color }};">
  <div class="busybee-scrub-story__proof">
    <div class="busybee-scrub-story__proof-inner">
      {% if section.settings.review_quote != blank %}
        <h2>{{ section.settings.review_quote | escape }}</h2>
      {% endif %}
      {% if section.settings.review_author != blank %}
        <p class="busybee-scrub-story__author">{{ section.settings.review_author | escape }}</p>
      {% endif %}

      <div class="busybee-scrub-story__steps">
        {% for i in (1..4) %}
          {% liquid
            assign title_key = 'step_' | append: i | append: '_title'
            assign text_key = 'step_' | append: i | append: '_text'
            assign step_title = section.settings[title_key]
            assign step_text = section.settings[text_key]
          %}
          <div class="busybee-scrub-story__step">
            {% if step_title != blank %}<h3>{{ step_title | escape }}</h3>{% endif %}
            {% if step_text != blank %}<div>{{ step_text }}</div>{% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="busybee-scrub-story__ritual-intro">
    <div class="busybee-scrub-story__narrow">
      {% if section.settings.ritual_heading != blank %}<h2>{{ section.settings.ritual_heading | escape }}</h2>{% endif %}
      {% if section.settings.ritual_text != blank %}<div>{{ section.settings.ritual_text }}</div>{% endif %}
    </div>
  </div>

  <div class="busybee-scrub-story__cards">
    {% for i in (1..3) %}
      {% liquid
        assign image_key = 'card_' | append: i | append: '_image'
        assign heading_key = 'card_' | append: i | append: '_heading'
        assign text_key = 'card_' | append: i | append: '_text'
        assign label_key = 'card_' | append: i | append: '_button_label'
        assign link_key = 'card_' | append: i | append: '_button_link'
        assign card_image = section.settings[image_key]
        assign card_heading = section.settings[heading_key]
        assign card_text = section.settings[text_key]
        assign card_label = section.settings[label_key]
        assign card_link = section.settings[link_key]
      %}
      <div class="busybee-scrub-story__card {% if i == 2 %}busybee-scrub-story__card--reverse{% endif %}">
        <div class="busybee-scrub-story__card-copy">
          {% if card_heading != blank %}<h2>{{ card_heading | escape }}</h2>{% endif %}
          {% if card_text != blank %}<div>{{ card_text }}</div>{% endif %}
          {% if card_label != blank and card_link != blank %}
            <a class="button" href="{{ card_link }}">{{ card_label | escape }}</a>
          {% endif %}
        </div>
        <div class="busybee-scrub-story__card-media">
          {% if card_image != blank %}
            {{ card_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200, 1400', sizes: '(min-width: 750px) 42vw, 100vw', alt: card_heading }}
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'busybee-scrub-story__placeholder' }}
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .busybee-scrub-story {
    background: var(--bb-page-bg);
    color: var(--bb-text);
  }

  .busybee-scrub-story__proof {
    background: var(--bb-accent-bg);
    padding: clamp(48px, 7vw, 84px) 0;
  }

  .busybee-scrub-story__proof-inner,
  .busybee-scrub-story__cards,
  .busybee-scrub-story__narrow {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
  }

  .busybee-scrub-story__proof h2,
  .busybee-scrub-story__ritual-intro h2 {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
    font-family: var(--font-heading--family);
  }

  .busybee-scrub-story__author {
    text-align: center;
    margin: 12px 0 38px;
    font-size: 0.875rem;
    letter-spacing: 0.04em;
  }

  .busybee-scrub-story__steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px;
  }

  .busybee-scrub-story__step {
    text-align: center;
  }

  .busybee-scrub-story__step h3 {
    margin: 0 0 8px;
    font-family: var(--font-heading--family);
    font-size: 1rem;
  }

  .busybee-scrub-story__step p {
    margin: 0;
  }

  .busybee-scrub-story__ritual-intro {
    padding: clamp(50px, 7vw, 86px) 0 30px;
  }

  .busybee-scrub-story__narrow {
    max-width: 760px;
    text-align: center;
  }

  .busybee-scrub-story__narrow > div {
    margin-top: 12px;
  }

  .busybee-scrub-story__narrow p {
    margin: 0;
  }

  .busybee-scrub-story__cards {
    display: grid;
    gap: 28px;
    padding-bottom: clamp(54px, 7vw, 86px);
  }

  .busybee-scrub-story__card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 380px;
    overflow: hidden;
    background: var(--bb-card-bg);
    border-radius: 20px;
  }

  .busybee-scrub-story__card--reverse .busybee-scrub-story__card-copy {
    order: 2;
  }

  .busybee-scrub-story__card-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 16px;
    padding: clamp(30px, 5vw, 58px);
  }

  .busybee-scrub-story__card-copy h2,
  .busybee-scrub-story__card-copy p {
    margin: 0;
  }

  .busybee-scrub-story__card-copy h2 {
    font-family: var(--font-heading--family);
  }

  .busybee-scrub-story__card-media {
    min-height: 360px;
  }

  .busybee-scrub-story__card-media img,
  .busybee-scrub-story__placeholder {
    width: 100%;
    height: 100%;
    min-height: 360px;
    display: block;
    object-fit: cover;
  }

  .busybee-scrub-story__placeholder {
    background: rgb(255 255 255 / 45%);
  }

  @media screen and (max-width: 749px) {
    .busybee-scrub-story__proof-inner,
    .busybee-scrub-story__cards,
    .busybee-scrub-story__narrow {
      width: min(100% - 24px, 1180px);
    }

    .busybee-scrub-story__steps {
      grid-template-columns: 1fr 1fr;
      gap: 28px 18px;
    }

    .busybee-scrub-story__card {
      grid-template-columns: 1fr;
      border-radius: 14px;
    }

    .busybee-scrub-story__card--reverse .busybee-scrub-story__card-copy {
      order: 0;
    }

    .busybee-scrub-story__card-media,
    .busybee-scrub-story__card-media img,
    .busybee-scrub-story__placeholder {
      min-height: 280px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Sugar scrub story",
  "settings": [
    {
      "type": "header",
      "content": "Customer review"
    },
    {
      "type": "text",
      "id": "review_quote",
      "label": "Quote",
      "default": "I've tried the oatmeal scrub — smelled so good and I didn't want to get out of the shower!"
    },
    {
      "type": "text",
      "id": "review_author",
      "label": "Customer",
      "default": "— @iamsheilasnow"
    },
    {
      "type": "header",
      "content": "Four routine points"
    },
    {
      "type": "text",
      "id": "step_1_title",
      "label": "Point 1 title",
      "default": "Exfoliate gently"
    },
    {
      "type": "richtext",
      "id": "step_1_text",
      "label": "Point 1 text",
      "default": "<p>Massage onto damp skin using light circular motions. Let the sugar do the work rather than pressing hard.</p>"
    },
    {
      "type": "text",
      "id": "step_2_title",
      "label": "Point 2 title",
      "default": "Focus on rough spots"
    },
    {
      "type": "richtext",
      "id": "step_2_text",
      "label": "Point 2 text",
      "default": "<p>Spend a little extra time on elbows, knees, legs, and other areas that tend to feel dry or textured.</p>"
    },
    {
      "type": "text",
      "id": "step_3_title",
      "label": "Point 3 title",
      "default": "Rinse clean"
    },
    {
      "type": "richtext",
      "id": "step_3_text",
      "label": "Point 3 text",
      "default": "<p>Rinse thoroughly with warm water and pat your skin dry instead of rubbing.</p>"
    },
    {
      "type": "text",
      "id": "step_4_title",
      "label": "Point 4 title",
      "default": "Follow with moisture"
    },
    {
      "type": "richtext",
      "id": "step_4_text",
      "label": "Point 4 text",
      "default": "<p>Finish with your favorite body moisturizer or oil while skin still feels slightly damp.</p>"
    },
    {
      "type": "header",
      "content": "Ritual introduction"
    },
    {
      "type": "text",
      "id": "ritual_heading",
      "label": "Heading",
      "default": "Build your body-care ritual."
    },
    {
      "type": "richtext",
      "id": "ritual_text",
      "label": "Text",
      "default": "<p>A sugar scrub works best as one step in a simple routine: soften with water, exfoliate gently, rinse, then moisturize.</p>"
    },
    {
      "type": "header",
      "content": "Card 1"
    },
    {
      "type": "image_picker",
      "id": "card_1_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "card_1_heading",
      "label": "Heading",
      "default": "Start with damp skin"
    },
    {
      "type": "richtext",
      "id": "card_1_text",
      "label": "Text",
      "default": "<p>Warm water helps prep the skin so the scrub can glide more comfortably. Scoop a small amount and work in gentle circles.</p>"
    },
    {
      "type": "text",
      "id": "card_1_button_label",
      "label": "Button label",
      "default": "Shop sugar scrubs"
    },
    {
      "type": "url",
      "id": "card_1_button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Card 2"
    },
    {
      "type": "image_picker",
      "id": "card_2_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "card_2_heading",
      "label": "Heading",
      "default": "Buff where you need it"
    },
    {
      "type": "richtext",
      "id": "card_2_text",
      "label": "Text",
      "default": "<p>Give extra attention to rough-feeling areas, but keep the pressure light. More pressure does not mean better exfoliation.</p>"
    },
    {
      "type": "text",
      "id": "card_2_button_label",
      "label": "Button label",
      "default": "Shop sugar scrubs"
    },
    {
      "type": "url",
      "id": "card_2_button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Card 3"
    },
    {
      "type": "image_picker",
      "id": "card_3_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "card_3_heading",
      "label": "Heading",
      "default": "Finish with moisture"
    },
    {
      "type": "richtext",
      "id": "card_3_text",
      "label": "Text",
      "default": "<p>After rinsing, pat dry and follow with a body moisturizer or oil to complete the routine and keep skin feeling comfortable.</p>"
    },
    {
      "type": "text",
      "id": "card_3_button_label",
      "label": "Button label",
      "default": "Shop sugar scrubs"
    },
    {
      "type": "url",
      "id": "card_3_button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "page_background",
      "label": "Page background",
