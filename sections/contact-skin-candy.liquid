<section
  class="busybee-contact"
  style="
    --contact-cream: {{ section.settings.cream_background }};
    --contact-white: {{ section.settings.white_background }};
    --contact-tan: {{ section.settings.tan_background }};
    --contact-brown: {{ section.settings.brand_brown }};
    --contact-border: {{ section.settings.border_color }};
    --contact-text: {{ section.settings.text_color }};
  "
>
  <div class="busybee-contact__hero">
    <div class="busybee-contact__wrap busybee-contact__hero-inner">
      {% if section.settings.eyebrow != blank %}
        <p class="busybee-contact__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h1>{{ section.settings.heading | escape }}</h1>
      {% endif %}
      {% if section.settings.intro != blank %}
        <div class="busybee-contact__intro">{{ section.settings.intro }}</div>
      {% endif %}
    </div>
  </div>

  <div class="busybee-contact__main">
    <div class="busybee-contact__wrap busybee-contact__grid">
      <div class="busybee-contact__info">
        {% if section.settings.info_heading != blank %}
          <h2>{{ section.settings.info_heading | escape }}</h2>
        {% endif %}
        {% if section.settings.info_text != blank %}
          <div class="busybee-contact__rte">{{ section.settings.info_text }}</div>
        {% endif %}

        <div class="busybee-contact__help-list">
          <div class="busybee-contact__help-item">
            <span class="busybee-contact__number">01</span>
            <div>
              <h3>{{ section.settings.help_1_heading | escape }}</h3>
              <div>{{ section.settings.help_1_text }}</div>
            </div>
          </div>
          <div class="busybee-contact__help-item">
            <span class="busybee-contact__number">02</span>
            <div>
              <h3>{{ section.settings.help_2_heading | escape }}</h3>
              <div>{{ section.settings.help_2_text }}</div>
            </div>
          </div>
          <div class="busybee-contact__help-item">
            <span class="busybee-contact__number">03</span>
            <div>
              <h3>{{ section.settings.help_3_heading | escape }}</h3>
              <div>{{ section.settings.help_3_text }}</div>
            </div>
          </div>
        </div>
      </div>

      <div class="busybee-contact__form-card">
        {% if section.settings.form_heading != blank %}
          <h2>{{ section.settings.form_heading | escape }}</h2>
        {% endif %}
        {% if section.settings.form_text != blank %}
          <div class="busybee-contact__form-intro">{{ section.settings.form_text }}</div>
        {% endif %}

        {% form 'contact', class: 'busybee-contact__form' %}
          {% if form.posted_successfully? %}
            <div class="busybee-contact__success" role="status">
              {{ section.settings.success_message | escape }}
            </div>
          {% endif %}

          {% if form.errors %}
            <div class="busybee-contact__errors" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          <div class="busybee-contact__field-row">
            <div class="busybee-contact__field">
              <label for="ContactFormName-{{ section.id }}">Name</label>
              <input
                id="ContactFormName-{{ section.id }}"
                type="text"
                name="contact[name]"
                value="{{ form.name | escape }}"
                autocomplete="name"
                placeholder="Your name"
              >
            </div>
            <div class="busybee-contact__field">
              <label for="ContactFormEmail-{{ section.id }}">Email <span aria-hidden="true">*</span></label>
              <input
                id="ContactFormEmail-{{ section.id }}"
                type="email"
                name="contact[email]"
                value="{{ form.email | escape }}"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                placeholder="you@example.com"
                required
                {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}
              >
            </div>
          </div>

          <div class="busybee-contact__field-row">
            <div class="busybee-contact__field">
              <label for="ContactFormPhone-{{ section.id }}">Phone <span class="busybee-contact__optional">Optional</span></label>
              <input
                id="ContactFormPhone-{{ section.id }}"
                type="tel"
                name="contact[phone]"
                value="{{ form.phone | escape }}"
                autocomplete="tel"
                placeholder="Phone number"
              >
            </div>
            <div class="busybee-contact__field">
              <label for="ContactFormOrder-{{ section.id }}">Order number <span class="busybee-contact__optional">If applicable</span></label>
              <input
                id="ContactFormOrder-{{ section.id }}"
                type="text"
                name="contact[Order number]"
                placeholder="Order number"
              >
            </div>
          </div>

          <div class="busybee-contact__field">
            <label for="ContactFormTopic-{{ section.id }}">What can we help with?</label>
            <select id="ContactFormTopic-{{ section.id }}" name="contact[Topic]">
              <option value="Order support">Order support</option>
              <option value="Product question">Product question</option>
              <option value="Shipping or delivery">Shipping or delivery</option>
              <option value="Wholesale or collaboration">Wholesale or collaboration</option>
              <option value="Other">Other</option>
            </select>
          </div>

          <div class="busybee-contact__field">
            <label for="ContactFormMessage-{{ section.id }}">Message <span aria-hidden="true">*</span></label>
            <textarea
              id="ContactFormMessage-{{ section.id }}"
              rows="7"
              name="contact[body]"
              placeholder="Tell us how we can help"
              required
            >{{ form.body | escape }}</textarea>
          </div>

          <button type="submit" class="button busybee-contact__submit">
            {{ section.settings.button_label | escape }}
          </button>
        {% endform %}
      </div>
    </div>
  </div>

  <div class="busybee-contact__closing">
    <div class="busybee-contact__wrap busybee-contact__closing-grid">
      <div>
        {% if section.settings.closing_eyebrow != blank %}
          <p class="busybee-contact__eyebrow">{{ section.settings.closing_eyebrow | escape }}</p>
        {% endif %}
        {% if section.settings.closing_heading != blank %}
          <h2>{{ section.settings.closing_heading | escape }}</h2>
        {% endif %}
      </div>
      {% if section.settings.closing_text != blank %}
        <div class="busybee-contact__rte busybee-contact__closing-copy">{{ section.settings.closing_text }}</div>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .busybee-contact {
    color: var(--contact-text);
    background: var(--contact-white);
  }

  .busybee-contact__wrap {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
  }

  .busybee-contact__hero {
    background: var(--contact-cream);
    padding: clamp(56px, 8vw, 96px) 0;
    text-align: center;
  }

  .busybee-contact__hero-inner {
    max-width: 820px;
  }

  .busybee-contact__eyebrow {
    margin: 0 0 12px;
    color: var(--contact-brown);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .busybee-contact h1,
  .busybee-contact h2,
  .busybee-contact h3 {
    font-family: var(--font-heading--family);
  }

  .busybee-contact h1 {
    margin: 0 auto 18px;
    max-width: 760px;
    color: var(--contact-brown);
  }

  .busybee-contact__intro {
    max-width: 680px;
    margin: 0 auto;
    font-size: 1.05rem;
  }

  .busybee-contact__intro p,
  .busybee-contact__rte p,
  .busybee-contact__form-intro p,
  .busybee-contact__help-item p {
    margin: 0;
  }

  .busybee-contact__main {
    background: var(--contact-white);
    padding: clamp(56px, 7vw, 88px) 0;
  }

  .busybee-contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(40px, 7vw, 84px);
    align-items: start;
  }

  .busybee-contact__info {
    padding-top: 18px;
  }

  .busybee-contact__info > h2,
  .busybee-contact__form-card > h2 {
    margin: 0 0 14px;
    color: var(--contact-brown);
  }

  .busybee-contact__help-list {
    margin-top: 40px;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--contact-border);
  }

  .busybee-contact__help-item {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 18px;
    padding: 22px 0;
    border-bottom: 1px solid var(--contact-border);
  }

  .busybee-contact__help-item h3 {
    margin: 0 0 6px;
    color: var(--contact-brown);
    font-size: 1.05rem;
  }

  .busybee-contact__number {
    color: var(--contact-brown);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .busybee-contact__form-card {
    background: var(--contact-cream);
    border-radius: 20px;
    padding: clamp(28px, 4vw, 46px);
  }

  .busybee-contact__form-intro {
    margin-bottom: 28px;
  }

  .busybee-contact__form {
    display: grid;
    gap: 18px;
  }

  .busybee-contact__field-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .busybee-contact__field {
    display: grid;
    gap: 8px;
  }

  .busybee-contact__field label {
    font-size: 0.9rem;
    font-weight: 600;
  }

  .busybee-contact__optional {
    font-weight: 400;
    opacity: 0.65;
    font-size: 0.8rem;
  }

  .busybee-contact__field input,
  .busybee-contact__field select,
  .busybee-contact__field textarea {
    width: 100%;
    min-height: 48px;
    border: 1px solid var(--contact-border);
    border-radius: 12px;
    background: var(--contact-white);
    color: var(--contact-text);
    font: inherit;
    padding: 12px 14px;
    box-sizing: border-box;
  }

  .busybee-contact__field textarea {
    resize: vertical;
  }

  .busybee-contact__field input:focus,
  .busybee-contact__field select:focus,
  .busybee-contact__field textarea:focus {
    outline: 2px solid var(--contact-brown);
    outline-offset: 2px;
  }

  .busybee-contact__submit {
    width: 100%;
    min-height: 50px;
    margin-top: 2px;
    background: var(--contact-brown);
    color: #fff;
    border-color: var(--contact-brown);
  }

  .busybee-contact__success,
  .busybee-contact__errors {
    padding: 14px 16px;
    border-radius: 10px;
    background: var(--contact-white);
    border: 1px solid var(--contact-border);
  }

  .busybee-contact__closing {
    background: var(--contact-tan);
    padding: clamp(48px, 6vw, 72px) 0;
  }

  .busybee-contact__closing-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 56px;
    align-items: center;
  }

  .busybee-contact__closing h2 {
    margin: 0;
    max-width: 560px;
  }

  .busybee-contact__closing-copy {
    max-width: 540px;
  }

  @media screen and (max-width: 749px) {
    .busybee-contact__wrap {
      width: min(100% - 28px, 1180px);
    }

    .busybee-contact__grid,
    .busybee-contact__closing-grid,
    .busybee-contact__field-row {
      grid-template-columns: 1fr;
    }

    .busybee-contact__grid {
      gap: 40px;
    }

    .busybee-contact__closing-grid {
      gap: 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Contact us"
